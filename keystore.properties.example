# Copy this file to keystore.properties and fill in your values.
# keystore.properties is gitignored — never commit it.
#
# To generate a keystore:
#   keytool -genkey -v -keystore untangle-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias untangle
#
# Store the .jks file somewhere safe outside the repo (e.g. ~/keys/untangle-release.jks)

storeFile=/absolute/path/to/untangle-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=untangle
keyPassword=YOUR_KEY_PASSWORD
