{
  "expo": {
    "name": "untangle",
    "slug": "untangle",
    "version": "1.2.0",
    "scheme": "untangle",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "untangle needs microphone access to record your voice and create your daily journal.",
        "NSCameraUsageDescription": "untangle uses the camera so you can add photos to your journal entries.",
        "NSPhotoLibraryUsageDescription": "untangle accesses your photo library so you can attach images to journal entries.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.priyasingh.autojournal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-av",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow untangle to access your photos to attach them to journal entries.",
          "cameraPermission": "Allow untangle to use your camera to take photos for journal entries.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#e94560",
          "sounds": []
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MicWidget",
              "label": "untangle",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "Tap to start or stop voice monitoring",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5dddd28c-4e99-4303-afef-ba88d7266fa9"
      }
    },
    "owner": "acolourfulnoises-organization"
  }
}
