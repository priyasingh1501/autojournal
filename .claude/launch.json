{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Expo (Metro Bundler)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--", "--clear"],
      "port": 8081
    },
    {
      "name": "Expo iOS",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "ios"],
      "port": 8081
    },
    {
      "name": "Expo Android",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "19006", "--clear"],
      "port": 19006
    },
    {
      "name": "Expo Web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "19006"],
      "port": 19006
    }
  ]
}
