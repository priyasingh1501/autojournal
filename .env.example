# Auto Journal - Environment Variables Example
# These keys are entered directly in the app's Settings tab (stored locally on device).
# This file is for reference only — the app does NOT read from .env at runtime.

# OpenAI API Key — used for Whisper audio transcription
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key — used for Claude daily summary generation
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# RevenueCat Google Play SDK API key — used for Pro subscriptions on Android.
# Public key (safe to ship in client builds), starts with `goog_`.
# Get yours at: app.revenuecat.com → Apps & providers → Google Play app → Public API key.
# For EAS builds, also set as a secret: `eas secret:create --name EXPO_PUBLIC_REVENUECAT_ANDROID_KEY --value goog_...`
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
